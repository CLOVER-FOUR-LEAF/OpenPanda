#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-or-later
# panda-screen — OpenPanda reference actuator driver for screen capture.
#
# Usage:
#   panda-screen [--out FILE] [--display N]
#
# Captures the desktop screen to a PNG file and prints the path. This is the
# "eyes" half of desktop automation (computer use): snap the screen, hand the
# image to a vision-capable agent, then drive input back with panda-input.
#
# Backends, tried in order:
#   macOS   : screencapture (always present on Darwin)
#   Wayland : grim
#   X11     : gnome-screenshot, scrot, maim, ImageMagick import, ffmpeg x11grab
#   Windows : powershell System.Drawing capture (git-bash / MSYS)
#
# The driver captures the GRAPHICAL session of the user context it runs
# under. A service without a console session (launchd system domain,
# systemd --system, Windows Session 0) sees no screen — advertise this
# actuator only on nodes where a desktop session exists.
#
# Exit codes: 0 ok · 2 bad arguments · 3 no capture backend · 1 capture error.

set -eu

out=""
display=""

usage() {
    cat >&2 <<'EOF'
panda-screen [--out FILE] [--display N]
  --out FILE    PNG output path (default ./screen-<ts>-<pid>.png)
  --display N   display index (macOS screencapture -D; ignored elsewhere)
EOF
}

while [ $# -gt 0 ]; do
    case "$1" in
        --out)     out="$2"; shift 2 ;;
        --display) display="$2"; shift 2 ;;
        -h|--help) usage; exit 0 ;;
        *) usage; exit 2 ;;
    esac
done

if [ -z "$out" ]; then
    out="./screen-$(date +%Y%m%d-%H%M%S)-$$.png"
fi

os=$(uname -s 2>/dev/null || echo unknown)

# Best-effort session env on Linux: a headless-launched service often lacks
# DISPLAY/WAYLAND_DISPLAY even when a console session exists on :0.
if [ "$os" = "Linux" ]; then
    [ -z "${DISPLAY:-}" ] && [ -S /tmp/.X11-unix/X0 ] && export DISPLAY=:0
    [ -z "${WAYLAND_DISPLAY:-}" ] && [ -S "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/wayland-0" ] && export WAYLAND_DISPLAY=wayland-0
fi

mkdir -p "$(dirname "$out")" 2>/dev/null || true

if [ "$os" = "Darwin" ] && command -v screencapture >/dev/null 2>&1; then
    # -x: no shutter sound. -D selects the display when given.
    if [ -n "$display" ]; then
        set -- -x -D "$display" "$out"
    else
        set -- -x "$out"
    fi
    if ! screencapture "$@"; then
        echo "panda-screen: screencapture failed" >&2; exit 1
    fi
elif [ "$os" = "Linux" ]; then
    captured=0
    if [ -n "${WAYLAND_DISPLAY:-}" ] && command -v grim >/dev/null 2>&1; then
        grim "$out" && captured=1
    fi
    if [ "$captured" = 0 ] && [ -n "${DISPLAY:-}" ]; then
        if command -v gnome-screenshot >/dev/null 2>&1; then
            gnome-screenshot -f "$out" && captured=1
        elif command -v scrot >/dev/null 2>&1; then
            scrot -o "$out" && captured=1
        elif command -v maim >/dev/null 2>&1; then
            maim "$out" && captured=1
        elif command -v import >/dev/null 2>&1; then
            import -window root "$out" && captured=1
        elif command -v ffmpeg >/dev/null 2>&1; then
            ffmpeg -hide_banner -loglevel error -y -f x11grab -i "$DISPLAY" -frames:v 1 "$out" && captured=1
        else
            echo "panda-screen: DISPLAY is set but no X11 capture tool found (want gnome-screenshot, scrot, maim, import, or ffmpeg)" >&2
            exit 3
        fi
    fi
    if [ "$captured" = 0 ]; then
        if [ -z "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]; then
            echo "panda-screen: no graphical session (DISPLAY/WAYLAND_DISPLAY unset) — is the task running inside a desktop?" >&2
            exit 3
        fi
        echo "panda-screen: capture failed" >&2; exit 1
    fi
elif command -v powershell >/dev/null 2>&1 || command -v pwsh >/dev/null 2>&1; then
    # Windows (git-bash/MSYS): grab the full virtual screen with GDI+.
    ps=powershell; command -v powershell >/dev/null 2>&1 || ps=pwsh
    if command -v cygpath >/dev/null 2>&1; then
        win_out=$(cygpath -w "$out")
    else
        win_out=$out
    fi
    if ! PANDA_OUT="$win_out" "$ps" -NoProfile -NonInteractive -Command '
        Add-Type -AssemblyName System.Drawing,System.Windows.Forms
        $b = [System.Windows.Forms.SystemInformation]::VirtualScreen
        $bmp = New-Object System.Drawing.Bitmap $b.Width, $b.Height
        $g = [System.Drawing.Graphics]::FromImage($bmp)
        $g.CopyFromScreen($b.Left, $b.Top, 0, 0, $bmp.Size)
        $bmp.Save($env:PANDA_OUT, [System.Drawing.Imaging.ImageFormat]::Png)
        $g.Dispose(); $bmp.Dispose()
    ' ; then
        echo "panda-screen: powershell capture failed" >&2; exit 1
    fi
else
    echo "panda-screen: no capture backend on this host" >&2; exit 3
fi

[ -s "$out" ] || { echo "panda-screen: produced empty file: $out" >&2; exit 1; }
printf '%s\n' "$out"
